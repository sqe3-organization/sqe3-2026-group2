		{
			"name": "99 - Teardown",
			"item": [
				{
					"name": "Teardown - Archive Database and Clear Variables",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Teardown - Database archived successfully\", function () {",
									"    pm.response.to.have.status(200);",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson.in_trash).to.eql(true);",
									"});",
									"// Clear environment variables",
									"pm.environment.unset(\"database_id\");",
									"pm.environment.unset(\"data_source_id\");",
									"pm.environment.unset(\"comment_id\");",
									"pm.environment.unset(\"file_upload_id\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"in_trash\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{NOTION_BASE_URL}}/v1/databases/{{database_id}}",
							"host": [
								"{{NOTION_BASE_URL}}"
							],
							"path": [
								"v1",
								"databases",
								"{{database_id}}"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.request.headers.upsert({ key: 'Notion-Version', value: pm.environment.get('NOTION_VERSION') });",
					"pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('NOTION_TOKEN') });"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Collection-level assertions for DRY (Content-Type & SLA)",
					"pm.test(\"[Common] Response Content-Type is application/json\", function () {",
					"    if (pm.response.code !== 204 && pm.response.code !== 404) {",
					"        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
					"    }",
					"});",
					"pm.test(\"[Common] Response time is within 5000 ms SLA\", function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});"
				]
			}
		}
	],
	"variable": [
		{
			"key": "NOTION_BASE_URL",
			"value": "https://api.notion.com"
		}
	]
}