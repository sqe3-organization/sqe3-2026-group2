# Notion REST API (2025-09-03) Base Configuration
NOTION_BASE_URL=https://api.notion.com/v1
NOTION_VERSION=2025-09-03

# Primary Internal Integration Bearer Secret (Requires "Read user information including email addresses")
NOTION_TOKEN=ntn_YOUR_INTERNAL_INTEGRATION_SECRET

# Root Workspace Page UUID Shared with the Integration (Used by Blocks & Pages Suites)
PARENT_PAGE_ID=YOUR_SHARED_PARENT_PAGE_UUID

# Secondary Restricted Integration Secret (Configured with "No user information" for TC_USR_GET_006 403 test)
RESTRICTED_TOKEN=ntn_YOUR_NO_USER_CAPABILITY_SECRET

# Public OAuth 2.0 Integration Credentials (RFC 6749 / RFC 7009 / RFC 7662)
OAUTH_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
OAUTH_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
OAUTH_REDIRECT_URI=https://localhost:3000/auth/notion/callback
OAUTH_AUTH_CODE=sample_single_use_auth_code
OAUTH_ACCESS_TOKEN=ntn_YOUR_OAUTH_ACCESS_TOKEN
OAUTH_REFRESH_TOKEN=nrt_YOUR_OAUTH_REFRESH_TOKEN
