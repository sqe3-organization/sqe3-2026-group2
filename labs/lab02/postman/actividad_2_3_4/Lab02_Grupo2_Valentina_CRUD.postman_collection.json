{
	"info": {
		"_postman_id": "211a1c57-6326-4cfc-86e8-867adb2d1994",
		"name": "Lab02_Grupo2_Valentina_CRUD (Data Sources, Comments, File Uploads)",
		"description": "Colección con operaciones CRUD (o equivalentes) para los módulos asignados, basada en los Test Cases del Lab 1.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
