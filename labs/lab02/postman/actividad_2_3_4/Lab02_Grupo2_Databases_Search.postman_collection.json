								"{{NOTION_BASE_URL}}"
							],
							"path": [
								"v1",
								"databases",
								"{{database_id}}"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02 - Search",
			"item": [
				{
					"name": "Search - Búsqueda global",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"El código de estado es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const responseJson = pm.response.json();",
									"pm.test(\"La respuesta es una lista de resultados\", function () {",
									"    pm.expect(responseJson.object).to.eql(\"list\");",
									"    pm.expect(responseJson.results).to.be.an('array');",
									"});",
									"pm.test(\"Se encontró al menos un resultado\", function () {",
									"    pm.expect(responseJson.results.length).to.be.greaterThan(0);",
									"    // Verificamos que al menos uno sea un database",
									"    const foundDatabase = responseJson.results.some(item => item.object === 'database');",
									"    pm.expect(foundDatabase).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"query\": \"Base de Datos para Search\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{NOTION_BASE_URL}}/v1/search",
							"host": [
								"{{NOTION_BASE_URL}}"
							],
							"path": [
								"v1",
								"search"
							]
						}
					},
					"response": []
				}
			]
		}
