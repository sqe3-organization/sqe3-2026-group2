	"item": [
		{
			"name": "00 - Setup (Crear Database y Limpiar)",
			"item": [
				{
					"name": "Setup - Limpiar variables y crear base de datos",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Limpiamos las variables para que el Runner empiece limpio",
									"pm.environment.unset(\"database_id\");",
									"pm.environment.unset(\"data_source_id\");",
									"pm.environment.unset(\"comment_id\");",
									"pm.environment.unset(\"file_upload_id\");"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"El código de estado es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const responseJson = pm.response.json();",
									"pm.test(\"La base de datos se creó correctamente\", function () {",
									"    pm.expect(responseJson.object).to.eql(\"database\");",
									"    pm.expect(responseJson.id).to.be.a('string');",
									"});",
									"// Guardamos el ID para las siguientes peticiones",
									"pm.environment.set(\"database_id\", responseJson.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"parent\": {\n        \"type\": \"page_id\",\n        \"page_id\": \"{{NOTION_PAGE_ID}}\"\n    },\n    \"title\": [\n        {\n            \"type\": \"text\",\n            \"text\": {\n                \"content\": \"Base de Datos para Search\"\n            }\n        }\n    ],\n    \"properties\": {\n        \"Name\": {\n            \"title\": {}\n        }\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{NOTION_BASE_URL}}/v1/databases",
							"host": [
								"{{NOTION_BASE_URL}}"
							],
							"path": [
								"v1",
								"databases"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "01 - Databases CRUD",
			"item": [
				{
					"name": "DB - CREATE - Crear Database",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"El código de estado es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const responseJson = pm.response.json();",
									"pm.test(\"La base de datos se creó correctamente\", function () {",
									"    pm.expect(responseJson.object).to.eql(\"database\");",
									"    pm.expect(responseJson.id).to.be.a('string');",
									"});",
									"// Guardamos el ID por si acaso",
									"pm.environment.set(\"database_id\", responseJson.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"parent\": {\n        \"type\": \"page_id\",\n        \"page_id\": \"{{NOTION_PAGE_ID}}\"\n    },\n    \"title\": [\n        {\n            \"type\": \"text\",\n            \"text\": {\n                \"content\": \"Test DB\"\n            }\n        }\n    ],\n    \"properties\": {\n        \"Name\": {\n            \"title\": {}\n        }\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{NOTION_BASE_URL}}/v1/databases",
							"host": [
								"{{NOTION_BASE_URL}}"
							],
							"path": [
								"v1",
								"databases"
							]
						}
					},
					"response": []
				},
				{
					"name": "DB - READ - Recuperar Database",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"El código de estado es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const responseJson = pm.response.json();",
									"pm.test(\"Los datos de la base de datos son correctos\", function () {",
									"    pm.expect(responseJson.object).to.eql(\"database\");",
									"    pm.expect(responseJson.id).to.eql(pm.environment.get(\"database_id\"));",
									"    pm.expect(responseJson).to.have.property(\"data_sources\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{NOTION_BASE_URL}}/v1/databases/{{database_id}}",
							"host": [
								"{{NOTION_BASE_URL}}"
							],
							"path": [
								"v1",
								"databases",
								"{{database_id}}"
							]
						}
					},
					"response": []
				},
