							"path": [
								"v1",
								"databases",
								"{{database_id}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "DB - DELETE - Archivar Database",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"El código de estado es 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const responseJson = pm.response.json();",
									"pm.test(\"La base de datos fue archivada\", function () {",
									"    pm.expect(responseJson.in_trash).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"in_trash\": true\n}",
