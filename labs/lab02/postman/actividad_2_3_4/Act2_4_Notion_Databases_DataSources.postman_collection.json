{
  "info": {
    "_postman_id": "c71a39f0-2f19-4824-a241-9988bba12002",
    "name": "Act2_4_Notion_Databases_DataSources",
    "description": "SQE III Lab 02 - Group 2 (Activities #2, #3, #4). Automated test suite for Notion REST API (Notion-Version: 2025-09-03) covering Databases and Search (Sebastián Pereyra) and Data Sources (Valentina Molina Bustillos). Includes multi-tier assertions (status, latency, headers, schema, error codes), shared variable propagation, and stateful E2E workflows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01_Databases (Sebastián Pereyra)",
      "item": [
        {
          "name": "01_Happy_Path",
          "item": [
            {
              "name": "DATABASES - Positiva - Crear database con titulo (200)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200 OK\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"Response time is under 2500ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(2500);",
                      "});",
                      "pm.test(\"Response is a valid database container object\", function () {",
                      "    const res = pm.response.json();",
                      "    pm.expect(res.object).to.eql(\"database\");",
                      "    pm.expect(res.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                      "    pm.expect(res.parent.type).to.eql(\"page_id\");",
                      "    pm.expect(res.title[0].plain_text).to.eql(\"Test DB\");",
                      "    pm.expect(res.archived).to.be.false;",
                      "    pm.expect(res.in_trash).to.be.false;",
                      "    pm.environment.set(\"database_id\", res.id);",
                      "    if (res.data_sources && res.data_sources.length > 0) {",
                      "        pm.environment.set(\"data_source_id\", res.data_sources[0].id);",
                      "    }",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"parent\": { \"type\": \"page_id\", \"page_id\": \"{{parent_page_id}}\" },\n  \"title\": [{ \"text\": { \"content\": \"Test DB\" } }],\n  \"properties\": {\n    \"Name\": { \"title\": {} }\n  }\n}"
                },
                "url": {
                  "raw": "{{NOTION_BASE_URL}}/v1/databases",
                  "host": ["{{NOTION_BASE_URL}}"],
                  "path": ["v1", "databases"]
                }
              }
            },
            {
              "name": "DATABASES - Positiva - Obtener database por ID (200)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200 OK\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"Retrieved database matches active database_id\", function () {",
                      "    const res = pm.response.json();",
                      "    pm.expect(res.object).to.eql(\"database\");",
                      "    pm.expect(res.id).to.eql(pm.environment.get(\"database_id\"));",
                      "    pm.expect(res.parent.page_id).to.eql(pm.environment.get(\"parent_page_id\"));",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Accept", "value": "application/json" }
                ],
                "url": {
                  "raw": "{{NOTION_BASE_URL}}/v1/databases/{{database_id}}",
                  "host": ["{{NOTION_BASE_URL}}"],
                  "path": ["v1", "databases", "{{database_id}}"]
                }
              }
            },
            {
              "name": "DATABASES - Positiva - Actualizar titulo (200)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200 OK\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"Title updated successfully\", function () {",
                      "    const res = pm.response.json();",
                      "    pm.expect(res.title[0].plain_text).to.eql(\"Updated DB Title\");",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": [{ \"text\": { \"content\": \"Updated DB Title\" } }]\n}"
                },
                "url": {
                  "raw": "{{NOTION_BASE_URL}}/v1/databases/{{database_id}}",
                  "host": ["{{NOTION_BASE_URL}}"],
                  "path": ["v1", "databases", "{{database_id}}"]
                }
              }
            }
          ]
        },
