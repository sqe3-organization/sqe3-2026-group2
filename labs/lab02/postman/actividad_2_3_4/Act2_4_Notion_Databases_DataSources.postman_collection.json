                    "exec": [
                      "pm.test(\"Status code is 200 OK\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"Database created as untitled\", function () {",
                      "    const res = pm.response.json();",
                      "    pm.expect(res.title).to.be.an(\"array\").and.to.be.empty;",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"parent\": { \"type\": \"page_id\", \"page_id\": \"{{parent_page_id}}\" },\n  \"title\": [],\n  \"properties\": { \"Name\": { \"title\": {} } }\n}"
                },
                "url": {
                  "raw": "{{NOTION_BASE_URL}}/v1/databases",
                  "host": ["{{NOTION_BASE_URL}}"],
                  "path": ["v1", "databases"]
                }
              }
            }
          ]
        }
      ]
