    {
      "name": "04_E2E_Workflows",
      "item": [
        {
          "name": "E2E_01_Data_Source_Lifecycle (Valentina Molina)",
          "item": [
            {
              "name": "01 - E2E - POST Crear Data Source",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Step 1: Data source created\", function () {",
                      "    pm.response.to.have.status(200);",
                      "    const res = pm.response.json();",
                      "    pm.expect(res.object).to.eql(\"data_source\");",
                      "    pm.environment.set(\"data_source_id\", res.id);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"database_id\": \"{{database_id}}\",\n  \"properties\": {\n    \"Name\": { \"title\": {} },\n    \"Count\": { \"number\": { \"format\": \"number\" } }\n  }\n}"
                },
                "url": {
                  "raw": "{{NOTION_BASE_URL}}/v1/data_sources",
                  "host": ["{{NOTION_BASE_URL}}"],
                  "path": ["v1", "data_sources"]
                }
              }
            },
            {
              "name": "02 - E2E - GET Verificar Schema",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Step 2: Schema retrieved matches data_source_id\", function () {",
                      "    pm.response.to.have.status(200);",
                      "    const res = pm.response.json();",
                      "    pm.expect(res.id).to.eql(pm.environment.get(\"data_source_id\"));",
                      "    pm.expect(res.properties).to.have.property(\"Name\");",
                      "    pm.expect(res.properties).to.have.property(\"Count\");",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{NOTION_BASE_URL}}/v1/data_sources/{{data_source_id}}",
                  "host": ["{{NOTION_BASE_URL}}"],
                  "path": ["v1", "data_sources", "{{data_source_id}}"]
                }
              }
            },
            {
              "name": "03 - E2E - PATCH Agregar Columna Priority",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Step 3: Schema altered with Priority column\", function () {",
                      "    pm.response.to.have.status(200);",
                      "    const res = pm.response.json();",
                      "    pm.expect(res.properties).to.have.property(\"Priority\");",
                      "    pm.expect(res.properties.Priority.type).to.eql(\"select\");",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"properties\": {\n    \"Priority\": {\n      \"select\": {\n        \"options\": [\n          { \"name\": \"High\", \"color\": \"red\" },\n          { \"name\": \"Low\", \"color\": \"blue\" }\n        ]\n      }\n    }\n  }\n}"
                },
                "url": {
                  "raw": "{{NOTION_BASE_URL}}/v1/data_sources/{{data_source_id}}",
                  "host": ["{{NOTION_BASE_URL}}"],
                  "path": ["v1", "data_sources", "{{data_source_id}}"]
                }
              }
            },
            {
              "name": "04 - E2E - POST Insertar Fila",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Step 4: Page row created under data source\", function () {",
                      "    pm.response.to.have.status(200);",
                      "    const res = pm.response.json();",
                      "    pm.expect(res.object).to.eql(\"page\");",
                      "    pm.environment.set(\"e2e_page_id\", res.id);",
                      "});"
