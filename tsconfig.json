{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@core/*": ["./core/*"],
      "@main/*": ["./main/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": ["core/**/*.ts", "main/**/*.ts", "tests/**/*.ts", "tests/hooks/fileUploads"],
  "exclude": ["node_modules", "dist"]
}